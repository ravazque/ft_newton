# NVIDIA EGL driver start-up: zero-size realloc and posix_memalign calls, error kinds that exist from valgrind 3.21 and 3.22 on.
# Kept apart from valgrind.supp, since older versions refuse a whole file that names an unknown kind.

{
   newton_nvidia_realloc_zero
   Memcheck:ReallocZero
   fun:realloc
   obj:*/libnvidia-eglcore.so*
}
{
   newton_nvidia_memalign_zero
   Memcheck:BadSize
   fun:posix_memalign
   obj:*/libnvidia-eglcore.so*
}
