# Suppressions for code outside the project (window toolkit, GL drivers, C++ runtime, glibc loader), each named after its library.
# Error kinds added in valgrind 3.21 and 3.22 live in valgrind_recent.supp, since older versions refuse a whole file that names them.

{
   newton_fontconfig
   Memcheck:Leak
   ...
   obj:*/libfontconfig.so*
}

{
   newton_pango
   Memcheck:Leak
   ...
   obj:*/libpango-1.0.so*
}
{
   newton_pangocairo
   Memcheck:Leak
   ...
   obj:*/libpangocairo-1.0.so*
}
