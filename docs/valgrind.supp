# ---- glycin: Rust image loader (zbus, async-io, rayon, crossbeam) ----
# The "possibly lost" blocks from detached threads and async executors land here.
{
   newton_glycin
   Memcheck:Leak
   ...
   obj:*/libglycin-2.so*
}
{
   newton_glycin_loaders
   Memcheck:Leak
   ...
   obj:*/glycin-loaders/*
}
{
   newton_glycin_pixbufloader
   Memcheck:Leak
   ...
   obj:*/loaders/libpixbufloader-*glycin*.so*
}

# ---- GLFW + Wayland: the window itself. The two 192 B "definitely lost"
# blocks are wl_proxy objects from viewporter/fractional-scale that GLFW
# creates in glfwCreateWindow and does NOT destroy (known GLFW bug on
# Wayland). window_destroy already calls glfwDestroyWindow + glfwTerminate:
# this is not a missing cleanup. ----
{
   newton_glfw
   Memcheck:Leak
   ...
   obj:*/libglfw.so*
}
{
   newton_wayland_client
   Memcheck:Leak
   ...
   obj:*/libwayland-client.so*
}
{
   newton_wayland_cursor
   Memcheck:Leak
   ...
   obj:*/libwayland-cursor.so*
}
{
   newton_wayland_egl
   Memcheck:Leak
   ...
   obj:*/libwayland-egl.so*
}

# ---- NVIDIA / EGL / GLX driver: leaks and "still reachable" blocks owned by
# the driver, which keeps global state until exit. Not project code. ----
{
   newton_nvidia
   Memcheck:Leak
   ...
   obj:*/libnvidia-*.so*
}
# ---- NVIDIA EGL driver start-up: zero-size realloc / posix_memalign calls
# made while the driver initialises, reported as errors, not leaks ----
{
   newton_nvidia_realloc_zero
   Memcheck:ReallocZero
   fun:realloc
   obj:*/libnvidia-eglcore.so*
}
{
   newton_nvidia_memalign_zero
   Memcheck:BadSize
   fun:posix_memalign
   obj:*/libnvidia-eglcore.so*
}

# ---- Mesa (gallium): the GLSL compiler keeps its state until a clean exit ----
{
   newton_gallium
   Memcheck:Leak
   ...
   obj:*/libgallium*.so*
}
{
   newton_egl
   Memcheck:Leak
   ...
   obj:*/libEGL*.so*
}
{
   newton_glx
   Memcheck:Leak
   ...
   obj:*/libGLX*.so*
}
{
   newton_gldispatch
   Memcheck:Leak
   ...
   obj:*/libGLdispatch.so*
}

# ============================================================================
# Errors that are NOT leaks: the "Invalid read" in GTK's init (libgio, via
# libdecor-gtk -> gtk_init -> g_settings). Same origin, not project code.
# Silenced by error type (Addr*) + library.
# ============================================================================
{
   newton_gio_invalid_read_32
   Memcheck:Addr32
   ...
   obj:*/libgio-2.0.so*
}
{
   newton_gio_invalid_read_16
   Memcheck:Addr16
   ...
   obj:*/libgio-2.0.so*
}
{
   newton_gio_invalid_read_8
   Memcheck:Addr8
   ...
   obj:*/libgio-2.0.so*
}

# ============================================================================
